{
  "name": "frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "infisicalLauncher --path=/videoStreaming/front -- yarn react-router build",
    "dev": "infisicalLauncher --path=/videoStreaming/front/local -- yarn react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "lint": "infisicalLauncher --path=/videoStreaming/front/local -- yarn eslint .",
    "format": "infisicalLauncher --path=/videoStreaming/front/local -- yarn prettier --write .",
    "typecheck": "infisicalLauncher --path=/videoStreaming/front/local -- yarn react-router typegen && tsc",
    "test": "infisicalLauncher --path=/videoStreaming/front/local  -- yarn vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lighthouse": "yarn build && infisicalLauncher --path=/videoStreaming/front/local -- yarn lhci autorun",
    "check": "concurrently 'yarn typecheck' 'yarn lint' 'yarn format' 'yarn test' 'yarn lighthouse'",
    "codegen": "orval",
    "codegen:watch": "orval --watch"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@react-router/node": "^8.0.0",
    "@react-router/serve": "^8.0.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.102.8",
    "@tanstack/react-table": "^9.2.4",
    "@uppy/core": "^6.0.0",
    "@uppy/drag-drop": "^6.0.0",
    "@uppy/file-input": "^4.2.2",
    "@uppy/progress-bar": "^4.3.2",
    "@uppy/react": "^6.0.0",
    "@uppy/tus": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "hls.js": "^1.7.2",
    "isbot": "^5.1.40",
    "lucide-react": "^1.43.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router": "^8.0.0",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "turbo": "^2.9.14",
    "tw-animate-css": "^1.4.0",
    "web-vitals": "^6.2.1",
    "zod": "^4.5.4",
    "zod-form-data": "^3.0.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@react-router/dev": "8.4.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/eslint-plugin-query": "5.103.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/eslint-plugin-jsx-a11y": "6.10.1",
    "@types/hls.js": "1.0.0",
    "@types/node": "25.9.7",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@typescript-eslint/type-utils": "8.70.0",
    "@typescript-eslint/types": "8.70.0",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/eslint-plugin": "1.6.27",
    "concurrently": "10.0.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-config-turbo": "2.11.2",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-no-relative-import-paths": "1.7.3",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-testing-library": "7.16.2",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.12.0",
    "infisicalLauncher": "git+ssh://git@github.com:user-komeda/infisicalLauncher.git",
    "jsdom": "30.1.0",
    "lefthook": "2.1.14",
    "orval": "8.33.0",
    "prettier": "3.9.8",
    "prettier-plugin-tailwindcss": "0.8.1",
    "rollup-plugin-visualizer": "7.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  },
  "packageManager": "yarn@4.18.0"
}
