{
  "name": "frontend",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "infisicalLauncher --path=/videoStreaming/front -- yarn react-router build",
    "build:lighthouse": "infisicalLauncher --path=/videoStreaming/front/local -- yarn react-router build",
    "dev": "infisicalLauncher --path=/videoStreaming/front/local -- yarn react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "lint": "infisicalLauncher --path=/videoStreaming/front/local -- yarn eslint .",
    "format": "infisicalLauncher --path=/videoStreaming/front/local -- yarn prettier --write .",
    "typecheck": "infisicalLauncher --path=/videoStreaming/front/local -- yarn react-router typegen && tsc",
    "test": "infisicalLauncher --path=/videoStreaming/front/local  -- yarn vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lighthouse": "yarn build:lighthouse && infisicalLauncher --path=/videoStreaming/front/local -- yarn lhci autorun",
    "check": "concurrently 'yarn typecheck' 'yarn lint' 'yarn format' 'yarn test' 'yarn test:e2e' 'yarn lighthouse'",
    "codegen": "orval",
    "codegen:watch": "orval --watch"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@react-router/node": "^8.5.1",
    "@react-router/serve": "^8.5.1",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-table": "^9.3.1",
    "@uppy/core": "^6.3.0",
    "@uppy/drag-drop": "^6.0.1",
    "@uppy/file-input": "^4.2.2",
    "@uppy/progress-bar": "^4.3.2",
    "@uppy/react": "^6.1.0",
    "@uppy/tus": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "hls.js": "^1.7.4",
    "ioredis": "^6.0.0",
    "isbot": "^5.2.2",
    "jose": "^6.2.14",
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "shadcn": "^4.23.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "turbo": "^2.11.10",
    "tw-animate-css": "^1.4.0",
    "web-vitals": "^6.2.3",
    "zod": "^4.6.7",
    "zod-form-data": "^3.0.4",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.16.0",
    "@playwright/test": "1.65.0",
    "@react-router/dev": "8.5.1",
    "@tailwindcss/vite": "4.3.5",
    "@tanstack/eslint-plugin-query": "5.107.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.9",
    "@types/eslint-plugin-jsx-a11y": "6.10.1",
    "@types/hls.js": "1.0.0",
    "@types/ioredis": "5.0.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/type-utils": "8.72.2",
    "@typescript-eslint/types": "8.72.2",
    "@vitest/coverage-v8": "5.1.0",
    "@vitest/eslint-plugin": "1.6.28",
    "concurrently": "10.0.7",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-config-turbo": "2.11.10",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-no-relative-import-paths": "1.7.3",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-testing-library": "7.16.2",
    "eslint-plugin-unused-imports": "4.4.1",
    "globals": "17.14.0",
    "infisicalLauncher": "git+ssh://git@github.com:user-komeda/infisicalLauncher.git",
    "jsdom": "31.0.0",
    "lefthook": "2.2.2",
    "msw": "3.0.5",
    "orval": "8.47.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "rollup-plugin-visualizer": "7.1.3",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  },
  "packageManager": "yarn@4.18.1"
}
