{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": ["DEV", "CI", "NODE_ENV", "VITE_API_URL"],
  "tasks": {
    "dev": {
      "dependsOn": ["^dev"],
      "persistent": true,
      "cache": false,
      "env": ["GOPATH", "GOMODCACHE"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".react-router/**", "build/**"],
      "cache": true
    },
    "check": {
      "env": ["GOPATH", "GOMODCACHE", "GOLANGCI_LINT_CACHE"]
    },
    "prepare": {
      "env": ["GOPATH", "GOMODCACHE", "GOLANGCI_LINT_CACHE"]
    },
    "test": {
      "outputs": ["coverage/**", "coverage.out"]
    },
    "swagger": {},
    "codegen": {
      "dependsOn": ["^swagger"],
      "outputs": ["src/api/generated/**"]
    }
  }
}
