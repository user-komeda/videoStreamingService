{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": [
    "SESSION_PASSWORD",
    "JWT_SECRET",
    "BFF_JWT_SECRET",
    "JWT_ISSUER",
    "JWT_AUDIENCE",
    "REDIS_URL",
    "DEV",
    "CI"
  ],
  "tasks": {
    "dev": {
      "dependsOn": ["^dev"],
      "persistent": true,
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".react-router/**", "build/**"],
      "cache": true
    },
    "check": {
      "env": [],
      "cache": true
    },
    "test": {
      "outputs": ["coverage/**", "coverage.out"]
    },
    "swagger": {},
    "codegen": {
      "dependsOn": ["^swagger"],
      "outputs": ["src/api/generated/**"]
    }
  }
}
